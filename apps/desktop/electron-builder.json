{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.quickswap.desktop",
  "productName": "Quickswap",
  "copyright": "Copyright © 2026 Quickswap Technologies",
  "directories": {
    "output": "dist-release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../../packages/security/bin/QuickswapSecHelper.exe",
      "to": "bin/QuickswapSecHelper.exe"
    },
    {
      "from": "../../packages/security/bin/AccountHubSecHelper.exe",
      "to": "bin/AccountHubSecHelper.exe"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Quickswap",
    "uninstallDisplayName": "Quickswap Desktop"
  }
}
