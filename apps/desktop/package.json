{
  "name": "@accounthub/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "./dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:electron": "vite build --config vite.config.electron.ts",
    "build:renderer": "vite build",
    "build": "pnpm build:electron && pnpm build:renderer",
    "package:win": "pnpm build && electron-builder --config electron-builder.json --win",
    "start": "node ./scripts/start.js"
  },
  "dependencies": {
    "@accounthub/core": "workspace:*",
    "@accounthub/database": "workspace:*",
    "@accounthub/security": "workspace:*",
    "@accounthub/shared": "workspace:*",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^37.10.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
