{
  "name": "@quickswap/desktop",
  "version": "1.0.0",
  "description": "Quickswap - Universal desktop account manager for Windows",
  "author": "Quickswap Technologies",
  "private": true,
  "main": "./dist-electron/main/index.js",
  "scripts": {
    "dev": "node ./scripts/dev.js",
    "dev:web": "vite",
    "build:electron": "vite build --config vite.config.electron.ts",
    "build:renderer": "vite build",
    "build": "pnpm build:electron && pnpm build:renderer",
    "package:win": "pnpm build && electron-builder --config electron-builder.json --win",
    "start": "node ./scripts/start.js",
    "lint": "tsc --noEmit && tsc --project tsconfig.electron.json --noEmit",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@quickswap/core": "workspace:*",
    "@quickswap/database": "workspace:*",
    "@quickswap/security": "workspace:*",
    "@quickswap/shared": "workspace:*",
    "lucide-react": "^1.74.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "electron-updater": "^6.3.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
