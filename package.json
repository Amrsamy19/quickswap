{
  "name": "quickswap-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Quickswap - Universal desktop account manager for Windows",
  "scripts": {
    "dev": "pnpm --filter @quickswap/desktop dev",
    "dev:web": "pnpm --filter @quickswap/desktop dev:web",
    "start": "pnpm --filter @quickswap/desktop start",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @quickswap/desktop build",
    "package:win": "pnpm --filter @quickswap/desktop package:win",
    "compile:sec": "powershell -ExecutionPolicy Bypass -File ./packages/security/scripts/compile-helper.ps1",
    "test": "vitest run",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
